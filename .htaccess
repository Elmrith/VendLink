<IfModule mod_authz_core.c>
    <FilesMatch "(?i)^(?:\.env(?:\..*)?|composer\.(?:json|lock)|schema\.sql|database\.credentials\.php|email_config\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)^(?:\.env(?:\..*)?|composer\.(?:json|lock)|schema\.sql|database\.credentials\.php|email_config\.php)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>